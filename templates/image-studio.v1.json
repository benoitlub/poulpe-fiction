{
  "schemaVersion": "1.0",
  "templateId": "image-studio",
  "description": "Reusable per-parcel image generation through existing Publisher Mistral endpoints. Produces files only; no publication.",
  "provider": "registered-media-first",
  "generateEndpoint": "/api/production/mistral-image/test",
  "downloadEndpoint": "/api/production/mistral-image/content",
  "defaults": {
    "aspectRatio": "9:16",
    "style": "promotional",
    "outputFormat": "png",
    "allowMistralImage": false
  },
  "requiredConfig": [],
  "workflow": [
    "compose-prompt",
    "generate",
    "download",
    "validate",
    "archive",
    "review"
  ],
  "safety": {
    "automaticPosting": false,
    "requireHumanApprovalForPublication": true,
    "noInventedGenerationSuccess": true
  },
  "outputs": [
    "image",
    "generation-metadata",
    "parcel-id",
    "prompt"
  ],
  "capability": "image.studio",
  "execution": "existing-octopus-publisher-local-adapter",
  "artifactPolicy": {
    "verifyDownloadedHash": true,
    "verifyActualFile": true,
    "retainProvenance": true,
    "retainRights": true,
    "publicationEnabled": false
  },
  "requiredOneOf": [
    "assetId",
    "subject + allowMistralImage"
  ]
}
