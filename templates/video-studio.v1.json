{
  "schemaVersion": "1.0",
  "templateId": "video-studio",
  "description": "Compose a vertical short with Piper sound and captions from a registered moving gameplay clip or validated still image; no publication.",
  "defaults": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "durationSeconds": 20,
    "format": "mp4",
    "allowMistralText": false,
    "allowMistralImage": false
  },
  "requires": [
    "image-studio",
    "audio-studio"
  ],
  "workflow": [
    "select-parcel-owned-registered-video-or-image",
    "verify-provenance-and-visual-motion",
    "mix-audio",
    "render-mp4",
    "burn-synchronized-subtitles",
    "verify",
    "review"
  ],
  "safety": {
    "automaticPosting": false,
    "requireHumanApprovalForPublication": true
  },
  "capability": "video.studio",
  "execution": "existing-octopus-publisher-local-adapter",
  "artifactPolicy": {
    "verifyDownloadedHash": true,
    "verifyActualFile": true,
    "retainProvenance": true,
    "retainRights": true,
    "publicationEnabled": false
  },
  "options": {
    "videoAssetId": "Optional, only for video-studio seed template; must match a registered media asset with verified rights for the same parcel.",
    "stillFallback": "Existing image-studio asset or explicit Mistral image authorization."
  }
}
