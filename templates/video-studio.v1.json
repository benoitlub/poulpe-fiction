{
  "schemaVersion": "1.0",
  "templateId": "video-studio",
  "description": "Compose an offline vertical short from validated stills and audio, no publication.",
  "defaults": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "durationSeconds": 20,
    "format": "mp4"
  },
  "requires": [
    "image-studio",
    "audio-studio"
  ],
  "workflow": [
    "select-visuals",
    "animate-stills",
    "mix-audio",
    "render-mp4",
    "verify",
    "review"
  ],
  "safety": {
    "automaticPosting": false,
    "requireHumanApprovalForPublication": true
  }
}
