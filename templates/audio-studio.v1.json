{
  "schemaVersion": "1.0",
  "templateId": "audio-studio",
  "description": "Reusable soundtrack plan for parcel short videos; no external publication.",
  "defaults": {
    "language": "fr",
    "voiceProvider": "piper",
    "musicSource": "original-procedural-CC0",
    "durationSeconds": 20,
    "allowMistralText": false
  },
  "tracks": [
    "narration",
    "music",
    "sound-effects"
  ],
  "workflow": [
    "write-script",
    "synthesize-voice",
    "select-cleared-music",
    "mix-and-duck",
    "normalize",
    "verify"
  ],
  "safety": {
    "requireLicensedAudio": true,
    "automaticPosting": false,
    "noUnverifiedTtsSuccess": true
  },
  "capability": "audio.studio",
  "execution": "existing-octopus-publisher-local-adapter",
  "artifactPolicy": {
    "verifyDownloadedHash": true,
    "verifyActualFile": true,
    "retainProvenance": true,
    "retainRights": true,
    "publicationEnabled": false
  },
  "requiredOneOf": [
    "segments + scriptRights",
    "knowledge + allowMistralText"
  ],
  "normalization": {
    "integratedLufs": -16,
    "truePeakDbtp": -1.5,
    "sampleRate": 48000
  },
  "subtitleTiming": "measured-per-sentence-synthesis"
}
